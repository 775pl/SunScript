PORT=3000
SITE_URL=https://www.sunscript.fr
# Configure server-side only to activate the form. Verify the sending domain in Resend.
RESEND_API_KEY=
CONTACT_FROM=
# Production defaults to the owner's Umami site when both variables are absent.
# Explicitly leave BOTH blank to disable, including in production. Public settings.
UMAMI_WEBSITE_ID=
UMAMI_SCRIPT_URL=
# Usually leave blank: automatically uses the Cloud gateway or the script origin.
UMAMI_HOST_URL=
